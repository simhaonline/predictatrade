    "setup_2_strong_asia":      { "enabled": true, "killzone": "london_killzone", "requires": ["asia_bos", "asia_liquidity_grab", "poi_retrace"] },
    "setup_3_news_ny":          { "enabled": true, "killzone": "ny_killzone",     "requires": ["high_impact_news_today", "london_trap", "ny_expansion"], "ignore_london_move": true }
  },
  "entry_confirmation": {
    "sequence": ["liquidity_sweep", "break_of_structure", "poi_mitigation"],
    "bos_timeframe": "M5",
    "max_bars_between_sweep_and_bos": 12
  },
  "risk": {
    "risk_per_trade_pct": 1.0,
    "sl_pips_min": 20,
    "sl_pips_max": 25,
    "sl_atr_multiplier": 0.35,
    "sl_atr_period": 14,
    "sl_atr_timeframe": "M15",
    "min_rr_to_erl": 3.0,
    "max_spread_points": 35,
    "max_trades_per_day": 2,
    "max_concurrent_positions": 1,
    "daily_loss_limit_pct": 2.0,
    "weekly_loss_limit_pct": 5.0
  },
  "management": {
    "tp1": { "target": "asian_range_opposite", "close_pct": 50 },
    "move_sl_to_breakeven_after_tp1": true,
    "tp2": { "target": "external_range_liquidity", "close_pct": 50 },
    "trail": { "enabled": false, "method": "structure_swing" },
    "time_exit_utc": "17:00"
