 //+------------------------------------------------------------------+
+//| v1.30: MAE/MFE excursion update (called per tick per open position)|
+//| Tracks worst adverse / best favorable price move since entry, both |
+//| in price distance and normalized by initial risk (R). Purely       |
+//| additive telemetry — no trading behavior change.                   |
+//+------------------------------------------------------------------+
+void PAT_UpdateExcursions(long magic, bool isBuy, double entry, double sl0, double bid, double ask)
+{
+    int idx = PAT_RegFind(magic);
+    if(idx < 0) return;
+    double px = isBuy ? bid : ask;   // close-side price: worst/best realizable for this trade
+    double risk = MathAbs(entry - sl0);
+    if(risk <= 0) risk = 0;          // R stays 0 when risk unknown (warmup guard)
+    if(isBuy)
+    {
+        double fav = MathMax(0.0, px - entry);   // favorable for BUY = price above entry
+        double adv = MathMax(0.0, entry - px);   // adverse for BUY   = price below entry
+        if(fav > g_regMFE[idx]) g_regMFE[idx] = fav;
+        if(adv > g_regMAE[idx]) g_regMAE[idx] = adv;
+        if(risk > 0 && adv / risk > g_regMAE_R[idx]) g_regMAE_R[idx] = adv / risk;
+        if(risk > 0 && fav / risk > g_regMFE_R[idx]) g_regMFE_R[idx] = fav / risk;
+    }
+    else
+    {
+        double fav = MathMax(0.0, entry - px);
+        double adv = MathMax(0.0, px - entry);
+        if(fav > g_regMFE[idx]) g_regMFE[idx] = fav;
+        if(adv > g_regMAE[idx]) g_regMAE[idx] = adv;
+        if(risk > 0 && adv / risk > g_regMAE_R[idx]) g_regMAE_R[idx] = adv / risk;
+        if(risk > 0 && fav / risk > g_regMFE_R[idx]) g_regMFE_R[idx] = fav / risk;
+    }
+}
+
+// v1.30: snapshot-and-clear accessors for emit paths (partial close reports
+// deltas-so-far without resetting the lifetime trackers).
+double PAT_MAE_Price(long magic) { int i = PAT_RegFind(magic); return (i >= 0) ? g_regMAE[i]   : 0.0; }
+double PAT_MFE_Price(long magic) { int i = PAT_RegFind(magic); return (i >= 0) ? g_regMFE[i]   : 0.0; }
+double PAT_MAE_R(long magic)     { int i = PAT_RegFind(magic); return (i >= 0) ? g_regMAE_R[i] : 0.0; }
+double PAT_MFE_R(long magic)     { int i = PAT_RegFind(magic); return (i >= 0) ? g_regMFE_R[i] : 0.0; }
