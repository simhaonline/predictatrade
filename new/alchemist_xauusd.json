    "penalties": {
      "news_within_30min": -25,
      "spread_or_atr_out_of_band": -20
    },
    "hard_rejects": ["counter_htf_bias", "mitigated_poi", "outside_session"]
  },
  "data_requirements": [
    "ohlcv_m1", "ohlcv_m5", "ohlcv_m15", "ohlcv_h1", "ohlcv_h4",
    "ohlcv_d1", "ohlcv_w1", "ohlcv_mn1", "spread", "economic_calendar"
