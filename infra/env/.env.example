# ─────────────────────────────────────────────────────────────────────────────
# Predict-A-Trade — shared environment (.env)
#
# This file is gitignored and holds SECRETS. Copy it to `.env` (same dir) and
# fill in real values. NEVER commit the real `.env`.
#
# Backup off-host (S3-compatible) configuration. Consumed by:
#   - pat-backup-sync sidecar (continuous WAL + dump sync, ~60s)
#   - scripts/backup/offhost_backup.sh (on-demand push, wrapped by dr-kit.sh offhost)
#
# Works with ANY S3-compatible store: AWS S3, Cloudflare R2, Hetzner, Wasabi,
# MinIO, etc. For AWS S3 leave BACKUP_S3_ENDPOINT empty (uses the default
# s3.amazonaws.com region endpoint). For non-AWS, set the endpoint explicitly.
# ─────────────────────────────────────────────────────────────────────────────

# --- External S3 backup (off-host) -------------------------------------------
# Access key ID for the backup bucket. NON-SECRET-safe to share the *name* of the
# bucket/endpoint/region; the KEY and SECRET below are SECRETS — never commit them.
BACKUP_S3_ACCESS_KEY=

# Secret access key for the backup bucket. SECRET.
BACKUP_S3_SECRET_KEY=

# Region of the bucket, e.g. auto, eu-central, us-east-1, auto (Cloudflare R2).
BACKUP_S3_REGION=auto

# Bucket name (NOT a secret — safe to share).
BACKUP_S3_BUCKET=

# S3-compatible endpoint URL. Leave EMPTY for AWS S3 (uses default region EP).
# Examples (do NOT include trailing slash):
#   Cloudflare R2 : https://<accountid>.r2.cloudflarestorage.com
#   Hetzner       : https://<region>.your-objectstorage.com
#   Wasabi        : https://s3.<region>.wasabisys.com
#   MinIO         : https://minio.your-domain.com
BACKUP_S3_ENDPOINT=

# Object-key prefixes (optional; sane defaults shown).
BACKUP_S3_PREFIX=predictatrade/wal
BACKUP_S3_DB_PREFIX=predictatrade/db

# Server-Side Encryption for off-host objects. Leave "none" unless your provider
# supports per-object SSE (Hetzner S3 currently rejects it — see BACKUP_RESTORE.md).
# Use "AES256" or "aws:kms" only if your provider supports it.
BACKUP_S3_ENCRYPTION=none
