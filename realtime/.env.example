# Predict-A-Trade Realtime Engine — Environment Variables
# No real credentials in repository. Copy to .env and fill in production values.

# ─── Core ───
# DATABASE_URL loaded from /srv/predictatrade/xauusd/database_url.txt (gitignored, chmod 600)
VALKEY_ADDR=127.0.0.1:6379
HTTP_HOST=127.0.0.1
HTTP_PORT=13081
WS_PORT=13081
LOG_LEVEL=info

# ─── Market Data ───
PROVIDER_MODE=agent
SYMBOLS=XAUUSD
BASE_PRICE=2430.0
TICK_RATE_MS=500

# ─── Strategy ───
MAX_SPREAD_PIPS=3.0
MIN_RR=1.5
MAX_COST_TO_TARGET=0.35
MAX_EXPOSURE=5.0

# ─── PTB ───
PTB_ENABLED=true
PTB_SHADOW_MODE=true

# ─── Loss Recovery / Capital Protection ───
LOSS_RECOVERY_ENABLED=true
MAX_DAILY_LOSS_PERCENT=2.0
MAX_DAILY_LOSS_COUNT=3
MAX_CONSECUTIVE_LOSSES=2
# RECOVERY_SIZE_MULTIPLIER=0.50
# RECOVERY_MIN_CONFLUENCE=80
# RECOVERY_MIN_SETUP_QUALITY=A
# RECOVERY_MIN_CONFIDENCE=75
# RECOVERY_MAX_TRADES=3
# RECOVERY_EXIT_AFTER_WINS=2
# NORMAL_COOLDOWN_MINUTES=5
# RECOVERY_COOLDOWN_MINUTES=30
# HALT_COOLDOWN_MINUTES=60

# ─── Adaptation ───
ADAPTATION_ENABLED=true
# ADAPTATION_MAX_RISK_MULTIPLIER=1.0
# ADAPTATION_GLOBAL_HARD_MAX_RISK=0.02

# ─── Hedging (DISABLED BY DEFAULT) ───
HEDGING_ENABLED=false
# HEDGING_MIN_LOSS_THRESHOLD=0.5
# HEDGING_MAX_LOSS_THRESHOLD=3.0
# HEDGING_SIZE_CAP=0.5
# HEDGING_MAX_SIMULTANEOUS=2
# HEDGING_MAX_AGGREGATE_EXPOSURE=5.0
# HEDGING_MAX_DURATION_MIN=120
GRID_HEDGING_ENABLED=false
OPTIONS_HEDGING_ENABLED=false

# ─── ML Adaptation (DISABLED — RESEARCH ONLY) ───
ML_ADAPTATION_ENABLED=false
# ML_MIN_TRAINING_SAMPLES=100
# ML_MIN_CONFIDENCE=0.65
# ML_MODEL_STALE_MINUTES=1440

# ─── RL Strategy Optimizer ───
RL_MODE=disabled
# RL_MIN_CONFIDENCE=0.7
# RL_MAX_DRAWDOWN_PCT=10.0
# RL_MIN_PROFIT_FACTOR=1.3
# RL_MIN_TRADE_COUNT=50

# ─── Sentiment Engine (DISABLED BY DEFAULT) ───
SENTIMENT_ENABLED=false
# SENTIMENT_REFRESH_INTERVAL_SEC=300
# SENTIMENT_TIMEOUT_SEC=10
# SENTIMENT_MAX_RETRIES=3
# SENTIMENT_STALE_THRESHOLD_SEC=600

# ─── Sentiment Provider API Keys (optional, set if using) ───
# GDELT_API_KEY=
# NEWSAPI_KEY=
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# TWITTER_BEARER_TOKEN=

# ─── COT (Commitment of Traders) — optional, fails safe if not configured ───
COT_ENABLED=false
# FMP_API_KEY=  # Set to enable COT data from Financial Modeling Prep
COT_SYMBOL=GC  # Gold futures contract code

# ─── DXY (US Dollar Index) — Twelve Data API ───
DXY_ENABLED=false
# TWELVEDATA_API_KEY=  # Set to enable DXY from EUR/USD, USD/JPY, GBP/USD, USD/CAD, USD/SEK, USD/CHF
