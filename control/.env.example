# ─── Database ───
# DATABASE_URL loaded from /srv/predictatrade/xauusd/database_url.txt (gitignored, chmod 600)

# ─── JWT ───
JWT_SECRET=  # REQUIRED in production: min 32 random chars (supply via secret file)

# ─── Frontend URL (for password-reset links) ───
APP_FRONTEND_URL=https://platform.predictatrade.com

# ─── CORS (comma-separated list of allowed origins) ───
CORS_ORIGINS=https://platform.predictatrade.com,http://localhost:3000

# ─── Refresh token cookie configuration ───
AUTH_REFRESH_COOKIE_NAME=pat_refresh_token
AUTH_REFRESH_COOKIE_SAMESITE=lax
AUTH_REFRESH_COOKIE_PATH=/api/v1/auth
# AUTH_REFRESH_COOKIE_DOMAIN=.predictatrade.com  # Only set if cross-subdomain needed

# ─── Email provider ───
EMAIL_PROVIDER=smtp
EMAIL_FROM=no-reply@predictatrade.com
EMAIL_FROM_NAME=Predict-A-Trade

# ─── SMTP (if EMAIL_PROVIDER=smtp) ───
SMTP_HOST=mail.predictatrade.com
SMTP_PORT=587
SMTP_USERNAME=no-reply@predictatrade.com
SMTP_PASSWORD=  # REQUIRED: set via production secret (do not commit)

# ─── Rate limiting ───
# Global: 60 req/min per IP (configured in app.module.ts)
# Per-route overrides on auth endpoints via @Throttle decorator

# ─── Server ───
CONTROL_HOST=127.0.0.1
CONTROL_PORT=13080
NODE_ENV=development
