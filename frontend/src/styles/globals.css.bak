/* Predict-A-Trade v1.0.0 — Design Token System (SOW Section 186) */
:root {
  /* Shared tokens */
  --font-family: Inter, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  --font-mono: 'JetBrains Mono', 'Cascadia Code', Consolas, monospace;
  --font-size-11: 11px;
  --font-size-12: 12px;
  --font-size-13: 13px;
  --font-size-14: 14px;
  --font-size-16: 16px;
  --font-size-20: 20px;
  --font-size-24: 24px;
  --font-size-32: 32px;
  --radius-sm: 4px;
  --radius-md: 8px;
  --radius-lg: 12px;
  --radius-full: 9999px;
  --spacing-1: 4px;
  --spacing-2: 8px;
  --spacing-3: 12px;
  --spacing-4: 16px;
  --spacing-6: 24px;
  --spacing-8: 32px;
  --spacing-12: 48px;
}

/* Dark theme (default for trading surfaces — SOW Section 187.1) */
[data-theme="dark"] {
  --surface-base: #121B2B;
  --surface-raised: #172030;
  --surface-elevated: #1C2637;
  --surface-sidebar: #282F3E;
  --surface-hover: #354152;
  --border-subtle: #2B3547;
  --text-primary: #F9F9FA;
  --text-secondary: #B7BBC4;
  --text-muted: #9297A0;
  --accent-primary: #145CFA;
  --accent-hover: #4F98EC;
  --status-up: #06D66F;
  --status-down: #E86161;
  --status-warning: #E9A265;
  --status-danger: #E86161;
  --status-info: #4F98EC;
  --status-neutral: #9297A0;
  --color-brand-gold: #E9A265;
  --chart-candle-up: #06D66F;
  --chart-candle-down: #E86161;
  --chart-grid: rgba(43, 53, 71, 0.35);
  --chart-crosshair: #9297A0;
  --chart-vwap: #4F98EC;
}

/* Light theme (SOW Section 186.4) */
[data-theme="light"] {
  --surface-base: #FFFFFF;
  --surface-raised: #F5F7FA;
  --surface-elevated: #FFFFFF;
  --surface-sidebar: #FFFFFF;
  --surface-hover: #EDF0F5;
  --border-subtle: #E4E7EC;
  --text-primary: #0F1114;
  --text-secondary: #5B616E;
  --text-muted: #8A919E;
  --accent-primary: #145CFA;
  --accent-hover: #4F98EC;
  --status-up: #16C784;
  --status-down: #EA3943;
  --status-warning: #B9761F;
  --status-danger: #EA3943;
  --status-info: #145CFA;
  --status-neutral: #8A919E;
  --color-brand-gold: #E9A265;
  --chart-candle-up: #16C784;
  --chart-candle-down: #EA3943;
  --chart-grid: rgba(228, 231, 236, 0.6);
  --chart-crosshair: #5B616E;
  --chart-vwap: #145CFA;
}

* { margin: 0; padding: 0; box-sizing: border-box; }

body {
  font-family: var(--font-family);
  background: var(--surface-base);
  color: var(--text-primary);
  font-size: var(--font-size-14);
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

/* Tabular nums for all numeric displays (SOW Section 188.1) */
.tabular { font-variant-numeric: tabular-nums; }

/* App shell (SOW Section 189) */
.app-shell { display: flex; min-height: 100vh; }
.sidebar { width: 240px; background: var(--surface-sidebar); border-right: 1px solid var(--border-subtle); transition: width 200ms ease; }
.sidebar.collapsed { width: 64px; }
.sidebar-section { padding: var(--spacing-2) var(--spacing-4); }
.sidebar-section-header { font-size: var(--font-size-11); text-transform: uppercase; color: var(--text-muted); letter-spacing: 0.05em; padding: var(--spacing-2) var(--spacing-4); }
.sidebar-item { display: flex; align-items: center; gap: var(--spacing-3); padding: var(--spacing-2) var(--spacing-4); color: var(--text-secondary); text-decoration: none; border-radius: var(--radius-sm); cursor: pointer; position: relative; }
.sidebar-item:hover { background: var(--surface-hover); color: var(--text-primary); }
.sidebar-item.active { background: rgba(20, 92, 250, 0.12); color: var(--accent-primary); }
.sidebar-item.active::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 3px; background: var(--accent-primary); border-radius: var(--radius-sm); }
.content { flex: 1; display: flex; flex-direction: column; overflow-x: hidden; }
.topbar { height: 56px; background: var(--surface-raised); border-bottom: 1px solid var(--border-subtle); display: flex; align-items: center; padding: 0 var(--spacing-6); gap: var(--spacing-4); }
.ticker-strip { height: 40px; background: var(--surface-base); border-bottom: 1px solid var(--border-subtle); display: flex; align-items: center; padding: 0 var(--spacing-6); gap: var(--spacing-6); overflow: hidden; font-size: var(--font-size-12); }
.page-content { flex: 1; padding: var(--spacing-6); overflow-y: auto; }

/* Cards */
.card { background: var(--surface-raised); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: var(--spacing-4); }
.card-elevated { background: var(--surface-elevated); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: var(--spacing-4); }

/* Status chips */
.chip { display: inline-flex; align-items: center; gap: var(--spacing-1); padding: 2px var(--spacing-2); border-radius: var(--radius-full); font-size: var(--font-size-12); font-weight: 500; }
.chip-up { background: rgba(6, 214, 111, 0.15); color: var(--status-up); }
.chip-down { background: rgba(232, 97, 97, 0.15); color: var(--status-down); }
.chip-warning { background: rgba(233, 162, 101, 0.15); color: var(--status-warning); }
.chip-neutral { background: rgba(146, 151, 160, 0.15); color: var(--status-neutral); }
.chip-info { background: rgba(79, 152, 236, 0.15); color: var(--status-info); }

/* KPI Stat */
.kpi-stat { display: flex; flex-direction: column; gap: var(--spacing-1); }
.kpi-stat-label { font-size: var(--font-size-12); color: var(--text-muted); }
.kpi-stat-value { font-size: var(--font-size-24); font-weight: 600; color: var(--text-primary); font-variant-numeric: tabular-nums; }
.kpi-stat-delta { font-size: var(--font-size-12); font-variant-numeric: tabular-nums; }

/* Signal card */
.signal-card { background: var(--surface-elevated); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: var(--spacing-4); }
.signal-card-direction { font-size: var(--font-size-20); font-weight: 700; display: flex; align-items: center; gap: var(--spacing-2); }
.signal-card-direction.buy { color: var(--status-up); }
.signal-card-direction.sell { color: var(--status-down); }
.signal-card-direction.no-trade { color: var(--status-neutral); }

/* Data table */
.data-table { width: 100%; border-collapse: collapse; }
.data-table th { text-align: left; padding: var(--spacing-2) var(--spacing-3); font-size: var(--font-size-12); color: var(--text-muted); border-bottom: 1px solid var(--border-subtle); font-weight: 500; }
.data-table td { padding: var(--spacing-2) var(--spacing-3); border-bottom: 1px solid var(--border-subtle); font-variant-numeric: tabular-nums; }

/* Button */
.btn { display: inline-flex; align-items: center; justify-content: center; gap: var(--spacing-2); padding: var(--spacing-2) var(--spacing-4); border-radius: var(--radius-md); border: 1px solid var(--border-subtle); background: var(--surface-raised); color: var(--text-primary); cursor: pointer; font-size: var(--font-size-14); font-weight: 500; transition: background 150ms; }
.btn:hover { background: var(--surface-hover); }
.btn-primary { background: var(--accent-primary); color: white; border-color: var(--accent-primary); }
.btn-primary:hover { background: var(--accent-hover); }
.btn-danger { color: var(--status-down); border-color: var(--status-down); }

/* Empty/loading states */
.empty-state { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: var(--spacing-12); color: var(--text-muted); }
.loading-state { display: flex; align-items: center; justify-content: center; padding: var(--spacing-8); color: var(--text-muted); }
.error-state { padding: var(--spacing-4); background: rgba(232, 97, 97, 0.1); border: 1px solid var(--status-down); border-radius: var(--radius-md); color: var(--status-down); }
.permission-denied { padding: var(--spacing-8); text-align: center; color: var(--text-muted); }

/* Grid layout */
.grid { display: grid; gap: var(--spacing-4); }
.grid-12 { grid-template-columns: repeat(12, 1fr); }
.col-span-2 { grid-column: span 2; }
.col-span-3 { grid-column: span 3; }
.col-span-6 { grid-column: span 6; }
.col-span-7 { grid-column: span 7; }
.col-span-9 { grid-column: span 9; }
.col-span-12 { grid-column: span 12; }

/* Demo/replay watermark */
.demo-watermark { position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%) rotate(-30deg); font-size: 48px; color: rgba(233, 162, 101, 0.15); pointer-events: none; z-index: 9999; font-weight: 700; }

/* Responsive */
@media (max-width: 768px) {
  .sidebar { position: fixed; z-index: 100; transform: translateX(-100%); }
  .sidebar.open { transform: translateX(0); }
  .grid-12 { grid-template-columns: 1fr; }
  .col-span-2, .col-span-3, .col-span-6, .col-span-7, .col-span-9 { grid-column: span 1; }
}
