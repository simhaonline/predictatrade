
# ─── News / Economic Calendar ───
NEWS_PROVIDER=disabled              # disabled|fmp|...
NEWS_MODE=PROTECT_ONLY              # OFF|PROTECT_ONLY|EVENT_BREAKOUT
NEWS_FAIL_POLICY=BLOCK_TRADING      # BLOCK_TRADING (fail-safe)|ALLOW_TRADING (not recommended)
NEWS_SYNC_INTERVAL_SEC=300          # 5 minutes
NEWS_STALE_AFTER_SEC=900            # 15 minutes
NEWS_PRE_BLACKOUT_MINUTES=15        # minutes before event to block trading
NEWS_POST_BLACKOUT_MINUTES=15       # minutes after event to block trading
NEWS_MIN_IMPACT=MEDIUM              # NONE|LOW|MEDIUM|HIGH|EXTREME
NEWS_PROVIDER_API_KEY=              # FMP API key (or other provider key)

# ─── News Breakout (DISABLED BY DEFAULT) ───
NEWS_BREAKOUT_ENABLED=false         # Must be explicitly enabled
NEWS_BREAKOUT_PREPARE_SECONDS=120   # How early to prepare before event
NEWS_BREAKOUT_EXPIRY_SECONDS=300    # How long after event to expire
NEWS_BREAKOUT_ENTRY_ATR_MULTIPLIER=0.5
NEWS_BREAKOUT_MAX_SPREAD=3.0
NEWS_BREAKOUT_MAX_RISK_PCT=1.0
NEWS_BREAKOUT_SL_ATR_MULTIPLIER=1.0
NEWS_BREAKOUT_TP_ATR_MULTIPLIER=2.0

# ─── Notifications (ALL DISABLED BY DEFAULT) ───
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_TELEGRAM_ENABLED=false
NOTIFICATION_PUSH_ENABLED=false

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# Push — self-hosted ntfy server (https://github.com/binwiederhier/ntfy)
# Android app: https://github.com/binwiederhier/ntfy-android
# iOS app: https://github.com/binwiederhier/ntfy-ios
NTFY_SERVER_URL=http://localhost:8090          # Your ntfy server URL
NTFY_TOPIC=predictatrade-alerts                # Notification topic
NTFY_ACCESS_TOKEN=                             # Optional auth token for protected topics

# v1.15.0 security: required. Agents must present this token on the data/execution WS.
# Generate a strong random value (openssl rand -hex 32) and set the SAME value in
# windows-agent.env. Without it the agent WS is unauthenticated.
AGENT_WS_TOKEN=
