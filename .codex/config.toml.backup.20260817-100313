# Predict-A-Trade v1.0.0 project-scoped Codex configuration.
# Loaded only when the project is trusted.

[agents]
default_subagent_model = "kimi-k2.7-code:cloud"
default_subagent_reasoning_effort = "medium"
enabled = true
max_concurrent_threads_per_session = 8

# Authoritative OpenAI developer documentation.
[mcp_servers.openaiDeveloperDocs]
url = "https://developers.openai.com/mcp"
enabled = true
required = false
startup_timeout_sec = 15
tool_timeout_sec = 60

# Version-aware framework/library documentation.
# CONTEXT7_API_KEY is optional but recommended for higher rate limits.
[mcp_servers.context7]
url = "https://mcp.context7.com/mcp"
bearer_token_env_var = "CONTEXT7_API_KEY"
enabled = true
required = false
startup_timeout_sec = 15
tool_timeout_sec = 60

# Browser/E2E verification. Use local/test/staging targets only.
[mcp_servers.playwright]
command = "npx"
args = ["-y", "@playwright/mcp@latest", "--headless"]
enabled = true
required = false
startup_timeout_sec = 30
tool_timeout_sec = 120

# Official GitHub MCP server. Read-only by default.
# Requires GITHUB_PERSONAL_ACCESS_TOKEN in the environment.
[mcp_servers.github]
command = "docker"
args = [
  "run", "-i", "--rm",
  "-e", "GITHUB_PERSONAL_ACCESS_TOKEN",
  "-e", "GITHUB_TOOLSETS",
  "ghcr.io/github/github-mcp-server",
  "--read-only"
]
env_vars = ["GITHUB_PERSONAL_ACCESS_TOKEN"]
env = { GITHUB_TOOLSETS = "repos,issues,pull_requests,actions,code_security" }
enabled = true
required = false
startup_timeout_sec = 30
tool_timeout_sec = 120
