# Predict-A-Trade — Go Real-Time Engine (RACE DETECTOR BUILD — diagnostic only)
FROM golang:1.25 AS builder

RUN apt-get update && apt-get install -y --no-install-recommends gcc libc6-dev && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN go clean -cache
RUN CGO_ENABLED=1 go build -race -o bin/realtime-engine ./cmd/realtime-engine/

# Runtime stage
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl tzdata && rm -rf /var/lib/apt/lists/*
ENV TZ=UTC

WORKDIR /app
COPY --from=builder /app/bin/realtime-engine /app/realtime-engine

EXPOSE 13081
CMD ["/app/realtime-engine"]
